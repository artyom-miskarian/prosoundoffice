# Contact form endpoint.
# Free key from https://web3forms.com — enter info@prosoundoffice.com, the key
# arrives by email. No account needed. Without this the form shows a mailto
# fallback instead of silently failing.
VITE_WEB3FORMS_KEY=

# Base URL serving the 59 product archives. Either host works:
#   Cloudflare R2   -> npm run upload-downloads-r2
#   GitHub Release  -> npm run upload-downloads
# Both scripts print the value to paste here.
VITE_DOWNLOADS_BASE_URL=
